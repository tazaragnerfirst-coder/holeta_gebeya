# Copy to .env for local testing (never commit the real .env file)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
FIREBASE_SERVICE_ACCOUNT_BASE64=base64_of_your_service_account_json
PORT=3000
# Your personal Telegram numeric user ID (e.g. from @userinfobot) —
# /notifyAdmin sends admin alerts (new reports, etc.) here.
ADMIN_TELEGRAM_ID=
# Public URL the Mini App is hosted at — used to build "Open" deep
# links in notifications.
MINI_APP_URL=
