rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True only for the admin-panel account (Firebase Auth
    // Email/Password), which has an `isAdmin: true` custom claim set
    // via backend/server/scripts/setAdminClaim.js. Telegram-signed-in
    // shoppers/sellers never have this claim, so this is false for
    // every regular app user regardless of what's in their own
    // users/{uid} doc.
    function isAdmin() {
      return request.auth != null && request.auth.token.isAdmin == true;
    }

    // Anyone can browse listings — no login required to look around.
    match /listings/{listingId} {
      allow read: if true;
      // Basic spam guard: a seller must wait at least 2 minutes
      // between posts. lastPostAt lives on their own users/{uid} doc
      // (admin-write-only — see below) and is bumped by the backend's
      // /recordPost endpoint right after a successful post, so this
      // check is enforced here in rules and can't be bypassed by
      // calling Firestore directly instead of going through the app.
      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || !('lastPostAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastPostAt + duration.value(2, 'm')
        )
        // A suspended seller (set by the admin panel) can't post new
        // listings. Their existing listings and browsing/messaging
        // are untouched — this only blocks new posts.
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspended != true
        );
      // Sellers can edit their own listing normally. Anyone (even
      // signed-out browsers) may also bump the public `views` counter
      // by exactly +1 and nothing else — it's a low-stakes public
      // stat, not sensitive data, so it isn't gated behind an account.
      allow update: if (request.auth != null && resource.data.sellerId == request.auth.uid)
        || isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.views == resource.data.views + 1);
      allow delete: if (request.auth != null && resource.data.sellerId == request.auth.uid) || isAdmin();
    }

    // Per-seller daily analytics (dashboard views/contact-click
    // charts). One doc per seller per day, id `${sellerId}_${date}`.
    // Private to the seller it belongs to. Anyone (even signed-out
    // buyers) may log an event — same public, increment-only pattern
    // as the `views` counter on listings — but only by exactly +1 on
    // exactly one of the two counters per write.
    match /sellerAnalytics/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.sellerId;
      allow create: if request.resource.data.keys().hasOnly(['sellerId', 'date', 'views', 'contacts'])
        && docId == request.resource.data.sellerId + '_' + request.resource.data.date
        && ((request.resource.data.views == 1 && request.resource.data.contacts == 0)
            || (request.resource.data.views == 0 && request.resource.data.contacts == 1));
      allow update: if request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.date == resource.data.date
        && ((request.resource.data.views == resource.data.views + 1 && request.resource.data.contacts == resource.data.contacts)
            || (request.resource.data.contacts == resource.data.contacts + 1 && request.resource.data.views == resource.data.views));
      allow delete: if false;
    }

    // Per-listing daily analytics (per-ad sparkline/trend on the
    // Views detail page). One doc per listing per day, id
    // `${listingId}_${date}`. Same shape/rules as sellerAnalytics
    // above, keyed by listing instead of seller so a seller with
    // several ads can see each ad's own trend.
    match /listingAnalytics/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.sellerId;
      allow create: if request.resource.data.keys().hasOnly(['listingId', 'sellerId', 'date', 'views', 'contacts'])
        && docId == request.resource.data.listingId + '_' + request.resource.data.date
        && ((request.resource.data.views == 1 && request.resource.data.contacts == 0)
            || (request.resource.data.views == 0 && request.resource.data.contacts == 1));
      allow update: if request.resource.data.listingId == resource.data.listingId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.date == resource.data.date
        && ((request.resource.data.views == resource.data.views + 1 && request.resource.data.contacts == resource.data.contacts)
            || (request.resource.data.contacts == resource.data.contacts + 1 && request.resource.data.views == resource.data.views));
      allow delete: if false;
    }

    // Seller reviews: publicly readable (shown on the listing page),
    // but only the reviewer can create/update their own review. The
    // client always writes with doc id `${listingId}_${buyerId}`, so
    // a resubmission overwrites the same review instead of stacking
    // duplicates.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.buyerId == request.auth.uid;
      allow delete: if false;
    }

    // Listing reports: write-only from the client (an admin reviews
    // these manually) — never readable back by regular users. The
    // admin panel can read/dismiss them.
    match /reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid;
    }

    // Users can read/write only their own profile doc. The admin
    // panel can also read any user's doc (for the User Management
    // list) and toggle ONLY the `suspended` field on it — every
    // other field (phone, name, telegramId, etc.) stays writable
    // only by the telegramAuth Cloud Function, same as before.
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended']);
      allow create, delete: if false; // only written by the telegramAuth Cloud Function (Admin SDK)

      // A user's saved/favorited listings. Unlike the parent doc,
      // this is written directly by the client (no backend
      // involved) — a favorite is low-stakes, purely personal data,
      // so it doesn't need admin-only verification like phone/name.
      match /favorites/{listingId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // App-wide config docs (e.g. the Profile-page header banner and
    // the home search-bar promo carousel). Publicly readable by the
    // main app; writable only by the admin panel.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Chats: only the two participants can read/write, and only once
    // a chat exists — created by the buyer via the client SDK. The
    // buyer's client checks "does our chat already exist?" via a
    // get() BEFORE the doc is created, so `resource` is null at that
    // point — the read rule has to allow that (nothing to leak from
    // a document that doesn't exist yet) or Firestore treats the
    // resulting rule-evaluation error as permission-denied.
    match /chats/{chatId} {
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
