rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can browse listings — no login required to look around.
    match /listings/{listingId} {
      allow read: if true;
      // Basic spam guard: a seller must wait at least 2 minutes
      // between posts. lastPostAt lives on their own users/{uid} doc
      // (admin-write-only — see below) and is bumped by the backend's
      // /recordPost endpoint right after a successful post, so this
      // check is enforced here in rules and can't be bypassed by
      // calling Firestore directly instead of going through the app.
      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || !('lastPostAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastPostAt + duration.value(2, 'm')
        );
      // Sellers can edit their own listing normally. Anyone (even
      // signed-out browsers) may also bump the public `views` counter
      // by exactly +1 and nothing else — it's a low-stakes public
      // stat, not sensitive data, so it isn't gated behind an account.
      allow update: if (request.auth != null && resource.data.sellerId == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.views == resource.data.views + 1);
      allow delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // Seller reviews: publicly readable (shown on the listing page),
    // but only the reviewer can create/update their own review. The
    // client always writes with doc id `${listingId}_${buyerId}`, so
    // a resubmission overwrites the same review instead of stacking
    // duplicates.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.buyerId == request.auth.uid;
      allow delete: if false;
    }

    // Listing reports: write-only from the client (an admin reviews
    // these manually) — never readable back by regular users.
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid;
    }

    // Users can read/write only their own profile doc.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // only written by the telegramAuth Cloud Function (Admin SDK)
    }

    // Chats: only the two participants can read/write, and only once
    // a chat exists — created by the buyer via the client SDK.
    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
